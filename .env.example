DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here
# Optional: set this to a server ID while developing so slash commands
# register instantly in that one server instead of taking up to an hour globally.
GUILD_ID=your-test-server-id-here

# Optional: channel to post the welcome message in. If unset, the bot
# will try to use the server's configured system channel.
WELCOME_CHANNEL_ID=
